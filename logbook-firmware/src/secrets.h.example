#pragma once

// Salin file ini jadi "secrets.h" (di folder yang sama), lalu isi kredensial asli di sana.
// secrets.h TIDAK ikut ke-commit ke git (sudah dikecualikan di .gitignore) -- ini cuma
// contoh format yang aman disimpan di repo.

// Identity itu "outer identity" buat handshake TLS awal EAP, biasanya sama persis
// dengan username. Beberapa kampus pakai format anonymous@realm buat identity (privacy),
// tapi kalau tidak yakin, isi sama dengan username saja dulu.
#define EDUROAM_SSID "eduroam"
#define EDUROAM_IDENTITY "username@kampus.ac.id"
#define EDUROAM_USERNAME "username@kampus.ac.id"
#define EDUROAM_PASSWORD "password_eduroam_kamu"
